NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mitracktivities
CLIENT_ORIGIN=http://localhost:5173


# Auth — JWT_SECRET must be a long random string (>= 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
VERIFICATION_CODE_TTL_MINUTES=15

# Mail (SMTP). Leave SMTP_HOST empty in development to log codes to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MiTracktivities <no-reply@mitracktivities.app>"
